#!/usr/bin/env python3
"""secret - CRUD for generic-password secrets in the macOS Keychain.

A friendly wrapper around the `security` CLI for API keys, tokens and PATs.

Usage:
  secret set <name>       Create or update a secret (hidden prompt, or piped stdin)
  secret get <name>       Print a secret's value to stdout
  secret rotate <name>    Replace an existing secret's value (refuses if absent)
  secret rm <name>        Delete a secret
  secret env              Print the env bundle as `export` lines, for eval
  secret env-edit         Edit the env bundle in $EDITOR (creates it if absent)
  secret env-import       Build the bundle from existing secrets (VAR=item on stdin)
  secret help             Show this help

The account defaults to $USER (override with $SECRET_ACCOUNT) and the service is
<name>, matching `security ... -a "$USER" -s <name>`, so secrets stored that way
stay reachable.

  secret set snyk_api_key
  secret rotate github_pat        # paste a freshly-rotated PAT

THE ENV BUNDLE

Each `secret get` costs a full Keychain round trip (~48 ms measured). Ten of
those in ~/.localrc cost ~480 ms on *every* shell start, which was ~78% of total
startup. The bundle keeps every value in the Keychain but in ONE item, so the
shell pays a single read:

  eval "$(secret env)"

Measured over 10 variables: ~590 ms -> ~90 ms.

  secret env-edit                                         # edit in $EDITOR
  printf 'SNYK_TOKEN=snyk_api_key\\n' | secret env-import  # from existing items

The item is $SECRET_ENV_NAME (default "shell_env") holding base64 of a block of
`export VAR='value'` lines. base64 because `security add-generic-password` takes
the value as an argument rather than on stdin, so the stored blob must be one
line. Values touch disk only as a mode-0600 temp file during env-edit, removed
on exit.

KNOWN LIMITATION (pre-existing, not introduced by the Python port): when a
secret's value contains bytes that are not printable ASCII -- a tab, or any
multibyte UTF-8 -- `security find-generic-password -w` returns a hex dump rather
than the value. That happens in the CLI itself, below this wrapper, and the old
shell implementation behaved identically. API tokens are ASCII-printable in
practice, so it does not bite; but do not store prose or unicode in here
expecting it back verbatim.

NOTE ON ~/.localrc: it deliberately does NOT call this script. This is Python,
and paying ~37 ms of interpreter start on every shell to read one Keychain item
is not worth it, so ~/.localrc inlines the equivalent `security | base64 -d`.
Keep the storage format here and that one line in sync -- `secret env` remains
the canonical reader and the thing to test against.
"""

from __future__ import annotations

import base64
import getpass
import hashlib
import os
import re
import subprocess
import sys
import tempfile

ACCOUNT = os.environ.get("SECRET_ACCOUNT") or os.environ.get("USER") or getpass.getuser()
ENV_NAME = os.environ.get("SECRET_ENV_NAME", "shell_env")

BUNDLE_TEMPLATE = """\
# Environment loaded by `eval "$(secret env)"`. One shell assignment per line.
# Stored as a single Keychain item, so the shell pays one read instead of one
# per variable. Lines starting with # are kept as-is.
#
# export EXAMPLE_TOKEN='value'
"""


class Error(Exception):
    """Anything that should exit 1 with a message rather than a traceback."""


# ------------------------------------------------------------------- keychain


def kc_read(service: str) -> str:
    """Return a secret's value, or raise if it does not exist.

    `security` writes the value to stdout with -w and a trailing newline that is
    not part of the secret, so strip exactly that.
    """
    p = subprocess.run(
        ["security", "find-generic-password", "-a", ACCOUNT, "-s", service, "-w"],
        capture_output=True,
        text=True,
        check=False,
    )
    if p.returncode != 0:
        raise Error(f"no secret named '{service}' for account '{ACCOUNT}'")
    return p.stdout.rstrip("\n")


def kc_exists(service: str) -> bool:
    try:
        kc_read(service)
        return True
    except Error:
        return False


def kc_write(service: str, value: str) -> None:
    """Store or replace a secret.

    -U updates in place if the item already exists. Note `security` takes the
    value as an argv element, so it is briefly visible in `ps` -- unavoidable,
    the CLI offers no stdin path for it. The env bundle exists partly to make
    this happen once rather than once per variable.
    """
    p = subprocess.run(
        ["security", "add-generic-password", "-a", ACCOUNT, "-s", service, "-w", value, "-U"],
        capture_output=True,
        text=True,
        check=False,
    )
    if p.returncode != 0:
        raise Error(f"failed to store '{service}' for account '{ACCOUNT}': {p.stderr.strip()}")


def kc_delete(service: str) -> None:
    p = subprocess.run(
        ["security", "delete-generic-password", "-a", ACCOUNT, "-s", service],
        capture_output=True,
        text=True,
        check=False,
    )
    if p.returncode != 0:
        raise Error(f"no secret named '{service}' for account '{ACCOUNT}'")


# ---------------------------------------------------------------------- input


def read_value(prompt: str) -> str:
    """Hidden prompt when interactive, otherwise a single line from stdin."""
    if sys.stdin.isatty():
        value = getpass.getpass(prompt)
    else:
        value = sys.stdin.readline().rstrip("\n")
    if not value:
        raise Error("empty value; nothing stored")
    return value


# --------------------------------------------------------------- env bundle


def shell_quote(value: str) -> str:
    """Single-quote a value so `eval` in sh/bash/zsh reproduces it exactly.

    Wrap in single quotes and replace each embedded ' with '\\''. Deliberately
    not shlex.quote(): it returns bare words unquoted, which is fine for eval but
    makes the stored bundle inconsistent and harder to eyeball. Deliberately not
    bash's %q either -- its $'...' output is not portable to every shell that
    might source this.
    """
    return "'" + value.replace("'", "'\\''") + "'"


def bundle_read() -> str:
    """Decode the bundle, or raise with a hint at how to create one."""
    try:
        raw = kc_read(ENV_NAME)
    except Error:
        raise Error(
            f"no env bundle '{ENV_NAME}' for account '{ACCOUNT}' "
            "(create one with: secret env-edit)"
        ) from None
    try:
        return base64.b64decode(raw, validate=True).decode("utf-8")
    except Exception as exc:
        raise Error(f"env bundle '{ENV_NAME}' is not valid base64: {exc}") from None


def bundle_write(text: str) -> None:
    if not text.strip():
        raise Error("bundle is empty; refusing to store it")
    kc_write(ENV_NAME, base64.b64encode(text.encode("utf-8")).decode("ascii"))


def cmd_env(_args: list[str]) -> int:
    sys.stdout.write(bundle_read())
    return 0


def cmd_env_edit(_args: list[str]) -> int:
    existing = bundle_read() if kc_exists(ENV_NAME) else BUNDLE_TEMPLATE
    fd, tmp = tempfile.mkstemp(prefix="secret.", suffix=".sh")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as fh:
            fh.write(existing)
        before = hashlib.sha256(existing.encode()).hexdigest()

        editor = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "vim"
        rc = subprocess.run([*editor.split(), tmp], check=False).returncode
        if rc != 0:
            raise Error(f"{editor} exited {rc}; bundle left untouched")

        with open(tmp, encoding="utf-8") as fh:
            edited = fh.read()
        if hashlib.sha256(edited.encode()).hexdigest() == before:
            print("No changes; bundle left untouched.")
            return 0

        bundle_write(edited)
        n = sum(1 for line in edited.splitlines() if line.strip().startswith("export "))
        print(f"Stored env bundle '{ENV_NAME}' ({n} export lines).")
        return 0
    finally:
        # Plaintext must not survive this process, however it exits.
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def cmd_env_import(_args: list[str]) -> int:
    """Compose the bundle from secrets that already exist individually.

    Reads `VAR=keychain-item` lines on stdin. Values are never printed.
    """
    lines = ["# Generated by: secret env-import. Edit with: secret env-edit"]
    count = 0
    for raw in sys.stdin:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise Error(f"malformed mapping (expected VAR=item): {line}")
        var, item = line.split("=", 1)
        var, item = var.strip(), item.strip()
        if not var or not item:
            raise Error(f"malformed mapping (expected VAR=item): {line}")
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", var):
            raise Error(f"'{var}' is not a valid shell variable name")
        try:
            value = kc_read(item)
        except Error:
            raise Error(f"no secret named '{item}' (needed for ${var})") from None
        lines.append(f"export {var}={shell_quote(value)}")
        count += 1
        print(f"  + {var} <- {item}", file=sys.stderr)

    if count == 0:
        raise Error("no mappings on stdin; nothing to import")
    bundle_write("\n".join(lines) + "\n")
    print(f"Imported {count} secret(s) into env bundle '{ENV_NAME}'.")
    return 0


# ------------------------------------------------------------------ commands


def _one_name(args: list[str], sub: str) -> str:
    if len(args) != 1 or not args[0]:
        raise Error(f"usage: secret {sub} <name>")
    return args[0]


def cmd_set(args: list[str]) -> int:
    name = _one_name(args, "set")
    kc_write(name, read_value(f"New value for '{name}': "))
    print(f"Stored '{name}' for account '{ACCOUNT}'.")
    return 0


def cmd_get(args: list[str]) -> int:
    print(kc_read(_one_name(args, "get")))
    return 0


def cmd_rotate(args: list[str]) -> int:
    name = _one_name(args, "rotate")
    if not kc_exists(name):
        raise Error(f"no secret named '{name}' to rotate (use 'secret set' to create it)")
    kc_write(name, read_value(f"New value for '{name}' (rotating): "))
    print(f"Rotated '{name}' for account '{ACCOUNT}'.")
    return 0


def cmd_rm(args: list[str]) -> int:
    name = _one_name(args, "rm")
    kc_delete(name)
    print(f"Deleted '{name}' for account '{ACCOUNT}'.")
    return 0


def cmd_help(_args: list[str]) -> int:
    # The module docstring IS the help text; keep them from drifting apart.
    print((__doc__ or "").strip())
    return 0


COMMANDS = {
    "set": cmd_set,
    "get": cmd_get,
    "rotate": cmd_rotate,
    "rm": cmd_rm,
    "delete": cmd_rm,
    "env": cmd_env,
    "env-edit": cmd_env_edit,
    "env-import": cmd_env_import,
    "help": cmd_help,
    "-h": cmd_help,
    "--help": cmd_help,
}


def main(argv: list[str]) -> int:
    sub = argv[0] if argv else "help"
    handler = COMMANDS.get(sub)
    if handler is None:
        print((__doc__ or "").strip(), file=sys.stderr)
        raise Error(f"unknown subcommand: {sub}")
    return handler(argv[1:])


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Error as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        # e.g. `secret env | head`
        sys.exit(0)
