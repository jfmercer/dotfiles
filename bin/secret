#!/usr/bin/env bash
#
# secret - a friendly wrapper around macOS's `security` CLI for doing CRUD on
# generic-password secrets (API keys, tokens, PATs) in the Apple Keychain.
#
# Usage:
#   secret set <name>       Create or update a secret (hidden prompt, or piped stdin)
#   secret get <name>       Print a secret's value to stdout (e.g. for ~/.localrc)
#   secret rotate <name>    Replace an existing secret's value (confirms overwrite)
#   secret rm <name>        Delete a secret
#
#   <name> may also be a variable in the env bundle (SNYK_TOKEN); those four
#   then read or rewrite that variable's line in the bundle instead.
#
#   secret env              Print the env bundle as `export` lines, for eval
#   secret env-edit         Edit the env bundle in $EDITOR (creates it if absent)
#   secret env-import       Build the bundle from existing secrets (VAR=item on stdin)
#   secret help             Show this help
#
# The account defaults to $USER (override with $SECRET_ACCOUNT) and the service
# is <name>, matching `security ... -a "$USER" -s <name>`, so existing secrets
# stored that way remain reachable. Example:
#
#   secret set snyk_api_key
#   export SNYK_TOKEN=$(secret get snyk_api_key)   # in ~/.localrc
#   secret rotate github_pat                        # paste a freshly-rotated PAT
#
# THE ENV BUNDLE
#
# Each `secret get` costs a Keychain round trip (~48 ms measured). Ten of them
# in ~/.localrc cost ~480 ms on *every* shell start -- most of total startup.
# The bundle stores all of those variables in ONE Keychain item, so the shell
# pays a single read:
#
#   eval "$(secret env)"                            # in ~/.localrc
#
# The item is named by $SECRET_ENV_NAME (default "shell_env") and holds a
# base64-encoded block of `export VAR='value'` lines. base64 keeps it on one
# line, which matters because `security add-generic-password` takes the value
# as an argument rather than on stdin.
#
# Values still live only in the Keychain; nothing is written to disk except a
# mode-0600 temp file during `env-edit`, removed on exit.

set -euo pipefail
IFS=$'\n\t'

account="${SECRET_ACCOUNT:-$USER}"

exit_with_error() {
    echo "ERROR: $1" >&2
    exit 1
}

usage() {
    awk 'NR<3{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"
}

# Read a secret value: hidden prompt when interactive, otherwise from stdin.
read_value() {
    local prompt="$1" value
    if [ -t 0 ]; then
        read -rs -p "$prompt" value
        echo >&2
    else
        IFS= read -r value || true
    fi
    [ -n "$value" ] || exit_with_error "empty value; nothing stored"
    printf '%s' "$value"
}

secret_exists() {
    security find-generic-password -a "$account" -s "$1" -w >/dev/null 2>&1
}

# ---------------------------------------------------------------- env bundle

env_name="${SECRET_ENV_NAME:-shell_env}"

# Single-quote a value for safe `eval` in sh/bash/zsh: wrap in single quotes and
# replace each embedded ' with '\''. Safer than bash's %q, whose $'...' output is
# not portable to every shell that might source the bundle.
shell_quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# Create a mode-0600 temp file and arrange for it to be removed however we exit.
new_tempfile() {
    local t
    t="$(umask 077; mktemp "${TMPDIR:-/tmp}/secret.XXXXXX")"
    printf '%s' "$t"
}

cmd_env() {
    security find-generic-password -a "$account" -s "$env_name" -w 2>/dev/null | base64 -d \
        || exit_with_error "no env bundle '$env_name' for account '$account' (create one with: secret env-edit)"
}

cmd_env_edit() {
    local tmp; tmp="$(new_tempfile)"
    # shellcheck disable=SC2064  # expand $tmp now, not at trap time
    trap "rm -f '$tmp'" EXIT INT TERM

    if secret_exists "$env_name"; then
        security find-generic-password -a "$account" -s "$env_name" -w | base64 -d > "$tmp"
    else
        cat > "$tmp" <<'TEMPLATE'
# Environment loaded by `eval "$(secret env)"`. One shell assignment per line.
# Stored as a single Keychain item, so the shell pays one read instead of one
# per variable. Lines starting with # are kept as-is.
#
# export EXAMPLE_TOKEN='value'
TEMPLATE
    fi

    local before after
    before="$(shasum -a 256 < "$tmp")"
    "${EDITOR:-nvim}" "$tmp"
    after="$(shasum -a 256 < "$tmp")"
    if [ "$before" = "$after" ]; then
        echo "No changes; bundle left untouched."
        return 0
    fi
    [ -s "$tmp" ] || exit_with_error "bundle is empty; refusing to store it"

    security add-generic-password -a "$account" -s "$env_name" \
        -w "$(base64 < "$tmp" | tr -d '\n')" -U \
        || exit_with_error "failed to store env bundle '$env_name'"
    echo "Stored env bundle '$env_name' ($(grep -c '^[[:space:]]*export' "$tmp") export lines)."
}

# Read `VAR=keychain-item` lines on stdin and compose the bundle from secrets
# that already exist individually. Values are never printed.
cmd_env_import() {
    local tmp; tmp="$(new_tempfile)"
    # shellcheck disable=SC2064
    trap "rm -f '$tmp'" EXIT INT TERM

    printf '# Generated by: secret env-import. Edit with: secret env-edit\n' > "$tmp"
    local line var item value n=0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue ;; esac
        var="${line%%=*}"
        item="${line#*=}"
        [ -n "$var" ] && [ -n "$item" ] && [ "$var" != "$line" ] \
            || exit_with_error "malformed mapping (expected VAR=item): $line"
        value="$(security find-generic-password -a "$account" -s "$item" -w 2>/dev/null)" \
            || exit_with_error "no secret named '$item' (needed for \$$var)"
        printf 'export %s=%s\n' "$var" "$(shell_quote "$value")" >> "$tmp"
        n=$((n + 1))
        echo "  + $var <- $item" >&2
    done

    [ "$n" -gt 0 ] || exit_with_error "no mappings on stdin; nothing to import"
    security add-generic-password -a "$account" -s "$env_name" \
        -w "$(base64 < "$tmp" | tr -d '\n')" -U \
        || exit_with_error "failed to store env bundle '$env_name'"
    echo "Imported $n secret(s) into env bundle '$env_name'."
}

# ------------------------------------------------- bundle variables by name
#
# set/get/rotate/rm accept a bundle variable (SNYK_TOKEN) as well as a
# standalone item (snyk_api_key), and a variable the bundle assigns wins. Without
# this they only ever saw standalone items: `secret get SNYK_TOKEN` failed, and
# worse, `secret get snyk_api_key` quietly returned whatever was imported,
# however long ago -- `env-edit` never updates the item it was imported from.

is_identifier() {
    [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]
}

# The bundle's plaintext; fails if there is no bundle.
bundle_text() {
    security find-generic-password -a "$account" -s "$env_name" -w 2>/dev/null | base64 -d
}

# Print the value that shell text $1 assigns to variable $2, plus a trailing "."
# so command substitution cannot strip trailing newlines; fail if it assigns
# none. Evaluated rather than parsed, so the answer is exactly what
# `eval "$(secret env)"` produces. The unset matters: ~/.localrc has already
# exported every bundle variable into the caller's environment.
value_assigned_by() {
    (
        unset "$2"
        eval "$1" >/dev/null 2>&1 || true
        [ -n "${!2+x}" ] || exit 1
        printf '%s.' "${!2}"
    )
}

in_bundle() {
    is_identifier "$1" || return 1
    local text
    text="$(bundle_text)" || return 1
    value_assigned_by "$text" "$1" >/dev/null
}

bundle_get() {
    local value
    value="$(value_assigned_by "$(bundle_text)" "$1")"
    printf '%s\n' "${value%.}"
}

# Replace variable $1's `export` line with line $2, or delete it if $2 is empty.
# Refuses anything a one-line edit cannot change safely -- more than one
# assignment, or one spanning several lines -- rather than half-rewrite it.
bundle_rewrite() {
    local name="$1" replacement="$2" text pattern lines
    text="$(bundle_text)"
    pattern="^[[:space:]]*export[[:space:]]+$name="
    lines="$(grep -E "$pattern" <<<"$text" || true)"
    [ -n "$lines" ] && [ "$(grep -c '' <<<"$lines")" -eq 1 ] \
        && [ "$(value_assigned_by "$lines" "$name" || true)" = "$(value_assigned_by "$text" "$name")" ] \
        || exit_with_error "\$$name is not a single one-line assignment in bundle '$env_name'; change it with: secret env-edit"

    text="$(NAME="$name" LINE="$replacement" awk '
        $0 ~ "^[[:space:]]*export[[:space:]]+" ENVIRON["NAME"] "=" {
            if (ENVIRON["LINE"] != "") print ENVIRON["LINE"]
            next
        }
        { print }' <<<"$text")"
    security add-generic-password -a "$account" -s "$env_name" \
        -w "$(printf '%s\n' "$text" | base64 | tr -d '\n')" -U \
        || exit_with_error "failed to store env bundle '$env_name'"
}

cmd_set() {
    local name="${1:-}"
    [ -n "$name" ] || exit_with_error "usage: secret set <name>"
    local value
    value="$(read_value "New value for '$name': ")"
    if in_bundle "$name"; then
        bundle_rewrite "$name" "export $name=$(shell_quote "$value")"
        echo "Stored \$$name in env bundle '$env_name'."
        return 0
    fi
    security add-generic-password -a "$account" -s "$name" -w "$value" -U \
        || exit_with_error "failed to store '$name' for account '$account'"
    echo "Stored '$name' for account '$account'."
}

cmd_get() {
    local name="${1:-}"
    [ -n "$name" ] || exit_with_error "usage: secret get <name>"
    if in_bundle "$name"; then
        bundle_get "$name"
        return 0
    fi
    security find-generic-password -a "$account" -s "$name" -w 2>/dev/null \
        || exit_with_error "no secret named '$name' for account '$account'"
}

cmd_rotate() {
    local name="${1:-}"
    [ -n "$name" ] || exit_with_error "usage: secret rotate <name>"
    local value
    if in_bundle "$name"; then
        value="$(read_value "New value for \$$name (rotating): ")"
        bundle_rewrite "$name" "export $name=$(shell_quote "$value")"
        echo "Rotated \$$name in env bundle '$env_name'."
        return 0
    fi
    secret_exists "$name" \
        || exit_with_error "no secret named '$name' to rotate (use 'secret set' to create it)"
    value="$(read_value "New value for '$name' (rotating): ")"
    security add-generic-password -a "$account" -s "$name" -w "$value" -U \
        || exit_with_error "failed to rotate '$name' for account '$account'"
    echo "Rotated '$name' for account '$account'."
}

cmd_rm() {
    local name="${1:-}"
    [ -n "$name" ] || exit_with_error "usage: secret rm <name>"
    if in_bundle "$name"; then
        bundle_rewrite "$name" ""
        echo "Deleted \$$name from env bundle '$env_name'."
        return 0
    fi
    security delete-generic-password -a "$account" -s "$name" >/dev/null 2>&1 \
        || exit_with_error "no secret named '$name' for account '$account'"
    echo "Deleted '$name' for account '$account'."
}

main() {
    local sub="${1:-help}"
    # Plain if/then rather than `A && B || true`: same behavior, but that
    # idiom trips SC2015 because C can run when A succeeds but B fails.
    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$sub" in
        set)            cmd_set "$@" ;;
        get)            cmd_get "$@" ;;
        rotate)         cmd_rotate "$@" ;;
        rm|delete)      cmd_rm "$@" ;;
        env)            cmd_env ;;
        env-edit)       cmd_env_edit ;;
        env-import)     cmd_env_import ;;
        help|-h|--help) usage ;;
        *)              usage >&2; exit_with_error "unknown subcommand: $sub" ;;
    esac
}

# Only dispatch when executed. Sourcing the file instead exposes the functions
# without running anything, which is how tests/bats/secret.bats reaches
# shell_quote directly -- its output is eval'd by every interactive shell, so it
# is worth testing against adversarial values rather than only end to end.
#
# if/then rather than `[ ... ] && main "$@"`: that form leaves a non-zero status
# as the last command when sourced, and `set -e` above would then kill the
# sourcing shell.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main "$@"
fi
