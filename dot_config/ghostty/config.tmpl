# MesloLGS is the Menlo derivative Nerd Fonts patches, so this is the closest
# Nerd Font to the "Menlo Regular for Powerline" this used to name -- that font
# carried only 7 private-use glyphs (U+E0A0-E0A2, U+E0B0-E0B3), just enough for
# Powerline separators. Nothing else on this Mac covers the rest of the Nerd
# Font ranges except .LastResort and a set of Arabic PUA fonts that claim the
# same codepoints for their own presentation forms, so an icon glyph rendered as
# a box or an unrelated ligature rather than simply going missing.
#
# The three axes in the cask's 18 variants:
#   LGS/LGM/LGL -- line gap. S is the tightest and the closest to Menlo's own
#                  line height (1.262 em vs Menlo's 1.164; M is 1.359, L 1.555).
#   plain, not  -- the choice here is about icon OUTLINE size, not cell count:
#   Mono/Propo     every glyph in both cuts advances the same 1233/2048 em. Mono
#                  scales icon outlines down to fit that cell exactly; this plain
#                  cut draws them at full size, so U+F015 spans 1.73 cells and
#                  U+E702 1.31 and they bleed into the next column. Bigger,
#                  better-looking icons, and the bleed is into a cell that is
#                  almost always the space after a filename. Propo is the cut
#                  that really is proportional -- 858 distinct advances -- and it
#                  is the one that would break column alignment. Avoid it.
#   no DZ       -- DZ is the dotted-zero cut; plain Meslo keeps Menlo's slashed
#                  zero, so this stays a font swap and not a glyph change too.
font-family = "MesloLGS Nerd Font"
font-size   = 22
theme       = "Molokai"
bell-features = no-title,no-attention,no-system,no-audio,no-border

# Land in herdr on launch. Bare `herdr` already starts the server if it is not
# running and attaches to the existing session if it is; bin/ghostty-session
# wraps it only to locate the binary (a GUI launch inherits none of the PATH an
# interactive zsh sets up) and to fall through to a login shell when herdr exits
# or is not installed, so a window can never open onto nothing.
#
# `initial-command`, not `command`: this applies only to the FIRST surface
# created at app launch, so new windows and Cmd-T tabs stay plain shells. The
# flip side, per Ghostty's own docs: once that first surface is closed there is
# no way to trigger this again, so a window opened afterwards is a plain shell
# until Ghostty is restarted.
#
# The chezmoi SOURCE directory, not $HOME: bin/ is listed in .chezmoiignore and
# runs in place, so no copy of this script ever exists under $HOME.
initial-command = {{ .chezmoi.sourceDir }}/bin/ghostty-session
