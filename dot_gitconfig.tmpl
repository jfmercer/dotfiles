[user]
    name = John F. Mercer
    email = {{ .email }}

[color]
    branch = true
    diff = true
    grep = true
    interactive = true
    status = true
    ui = true

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff-highlight"]
    oldNormal = red bold
    oldHighlight = red bold 52
    newNormal = green bold
    newHighlight = green bold 22

[color "diff"]
    meta = 227
    frag = magenta bold
    commit = 227 bold
    old = red bold
    new = green bold
    whitespace = red reverse

[color "interactive"]
    error = red bold

[color "status"]
    added = yellow
    changed = green
    untracked = red
    branch = magenta

[core]
    excludesfile = ~/.gitignore
    editor = nvim
    ignorecase = false
    # the default is 'less -FRSX'
    pager = hunk pager
    autocrlf = input

# delta is no longer the pager -- hunk is (see core.pager above). It is kept
# solely for interactive.diffFilter below, because `git add -p` needs a filter
# that colorizes a diff on stdout and hands it back to git. hunk is a
# full-screen TUI reviewer with no such stream mode, so it cannot fill that
# slot. These keys still apply on that path: --color-only drops delta's file
# header decoration but honors line-numbers.
[delta]
    navigate = true
    line-numbers = true
    # side-by-side = true

[diff]
    colorMoved = default

# Any git pull or git fetch will auto-prune, that is, any local branch whose
# corresponding remote is gone will be deleted.
[fetch]
    prune = true

[interactive]
    diffFilter = delta --color-only

[merge]
    # zdiff3 (Git 2.35+) is a strictly better diff3
    conflictStyle = zdiff3

[push]
    # This is the default in Git 2.0
    default = simple
    # Auto-create the upstream branch on first push (Git 2.37+)
    autoSetupRemote = true
{{- if get . "work" }}

# Work machines only. Personal machines keep git's built-in default (master),
# so this is deliberately inside the guard rather than a top-level setting.
# Only affects repositories created by `git init` from here on -- existing
# ones, this repo included, keep whatever branch they already have.
[init]
    defaultBranch = main

# Work machines only. Employer-specific settings (internal host names, URL
# rewrites) live in an untracked file so they stay out of this public repo.
# Create it by hand; git silently ignores the include if it does not exist.
# Kept last so anything in it overrides the settings above.
[include]
    path = ~/.gitconfig.work
{{- end }}
