{{- if and (eq .chezmoi.os "darwin") .install_mac_apps -}}
#!/usr/bin/env bash

set -eufo pipefail

# `chezmoi apply` is not an interactive zsh, so it does not inherit the PATH set
# by homebrew/path.zsh. On Apple Silicon /opt/homebrew/bin is not on the
# default PATH, so without this `brew bundle` below dies with "command not
# found" and takes the whole apply with it.
for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$brew_bin" ]; then
        eval "$("$brew_bin" shellenv)"
        break
    fi
done
unset brew_bin

# Mirror homebrew/exports.zsh so apply-time installs match what an interactive
# shell would do -- casks into ~/Applications, and checksums enforced.
export HOMEBREW_CASK_OPTS="--appdir=$HOME/Applications --require-sha"

{{ $brews := list
     "asdf"
     "atuin"
     "bat"
     "bash-completion"
     "bats-core"
     "cheat"
     "chezmoi"
     "colordiff"
     "ctags"
     "dockutil"
     "eza"
     "fd"
     "fzf"
     "gh"
     "git"
     "git-delta"
     "glow"
     "gpg"
     "grc"
     "herdr"
     "htop"
     "jq"
     "lazygit"
     "less"
     "navi"
     "nmap"
     "shellcheck"
     "ssh-copy-id"
     "telnet"
     "tig"
     "tmux"
     "trash"
     "tree"
     "vim"
     "wget" }}
{{/* Casks that ship a real sha256 upstream, so they satisfy the --require-sha
     in HOMEBREW_CASK_OPTS above:
       claude-code@latest      -- moved out of $casks_no_sha once upstream began
          publishing a checksum. It is a rolling cask, so the version and its
          sha256 change every release; brew takes both from the cask definition
          it just fetched, and nothing about the digest is pinned here. If
          upstream ever reverts to `:no_check` this install starts failing --
          which is the point, and better than silently dropping the check.
       font-meslo-lg-nerd-font -- Ghostty's font (dot_config/ghostty/config.tmpl),
          and Zed's, and gvim's. */}}
{{ $casks := list
     "claude-code@latest"
     "font-meslo-lg-nerd-font" }}
{{/* Casks upstream ships as `sha256 :no_check` -- they cannot satisfy
     --require-sha, so they are installed in a second pass with that flag
     dropped. Keep this list as short as possible and re-check with:
       brew info --cask --json=v2 <token> | jq -r '.casks[].sha256'
     Anything that gains a real checksum upstream should move to $casks.
     font-gentium-plus is unlikely ever to: its url is a git repo
     (github.com/google/fonts.git), not a release archive, so there is no
     immutable artifact for a checksum to describe. */}}
{{ $casks_no_sha := list
     "font-gentium-plus" }}

brew bundle --file=/dev/stdin <<EOF
{{ range ($brews | sortAlpha | uniq) }}
brew "{{ . }}"
{{- end }}
{{ range ($casks | sortAlpha | uniq) }}
cask "{{ . }}"
{{- end }}
EOF

{{ if $casks_no_sha }}
# Casks without an upstream checksum. --require-sha is stripped here only.
HOMEBREW_CASK_OPTS="--appdir=$HOME/Applications" brew bundle --file=/dev/stdin <<EOF
{{- range ($casks_no_sha | sortAlpha | uniq) }}
cask "{{ . }}"
{{- end }}
EOF
{{ end }}
{{- end -}}
