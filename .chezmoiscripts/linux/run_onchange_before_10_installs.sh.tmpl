{{- if and (eq .chezmoi.os "linux") .install_linux_apps -}}
#!/usr/bin/env bash

set -eufo pipefail

# if shell is interactive, prompt for sudo
if [[ $- == *i* ]]; then
  sudo -v
fi

# Keep-alive: update existing `sudo` time stamp until linux installs have finished
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

sudo apt update

packages=(
    "bat"
    "colordiff"
    "direnv"
    "fd-find"
    "fzf"
    "gh"
    "git"
    "gpg"
    "grc"
    "htop"
    "jq"
    "less"
    # Extended terminfo database. ncurses-base (always present) has xterm and
    # xterm-256color but NOT tmux-256color, which dot_tmux.conf sets as
    # default-terminal, nor screen-256color/alacritty/xterm-ghostty. Without
    # this, anything running inside tmux gets an unknown TERM.
    "ncurses-term"
    "nmap"
    "pipx"
    "ripgrep"
    "shellcheck"
    "tig"
    "tldr"
    "tmux"
    "tree"
    "ufw"
    "universal-ctags"
    "vim"
    "wget"
    "xclip"
)

# security only packages - kali only
# this separate list helps with Github CI to pass
{{ if eq .osid "linux-kali" }}

sec_packages=(
    "atuin"
    "bloodhound"
    "chisel"
    "cloud-enum"
    "dnscat2"
    "enum4linux-ng"
    "exploitdb"
    "feroxbuster"
    "hurl"
    "gobuster"
    "keepass2" # for oscp
    "ligolo-ng"
    "ncat"
    "neo4j"
    "netexec"
    "nishang"
    "obsidian"
    "oscanner"
    "p7zip-full"
    "pacu"
    "pandoc"
    "peass"
    "python3-wsgidav"
    "python-wsgidav-doc"
    "redshift-gtk" # maybe unneeded on VM
    "rlwrap"
    "seclists"
    "sipvicious"
    "snmp-mibs-downloader"
    "sshuttle"
    "texlive-fonts-extra"
    "texlive-latex-extra"
    "texlive-latex-recommended"
    "tnscmd10g"
    "wkhtmltopdf"
)
packages+=("${sec_packages[@]}")

{{ end }}

# Install all packages in a single transaction (faster and atomic)
echo "Installing packages: ${packages[*]}"
sudo apt install -y "${packages[@]}"

{{ if eq .osid "linux-kali" }}

# Install pipx packages
# NOTE: installing as root might mess this up
pipx_packages=(
    "git+https://github.com/brightio/penelope.git"
    "git+https://github.com/Tib3rius/AutoRecon.git"
    "git+https://github.com/Densaugeo/uploadserver.git"
    "git+https://github.com/arthaud/git-dumper.git"
    "poetry"
)

for pipx_package in "${pipx_packages[@]}"; do
    echo "Installing pipx package $pipx_package"
    pipx install "$pipx_package"
done

if [ -f /usr/share/wordlists/rockyou.gz ]; then
    echo "Unzipping rockyou wordlist"
    gzip -d /usr/share/wordlists/rockyou.gz
fi

{{ end }}

# Pinned upstream versions. Bump deliberately; see the bump recipes beside each.
# A GPG *public key* fingerprint. Published by upstream for exactly this
# purpose, so it is deliberately in the clear -- gitleaks' generic-api-key rule
# only flags it because the name contains "KEY" and the value is high-entropy.
EZA_KEY_FPR="1548BC8A4B4D2688F9B0DAF7EC29E2090CE3FD43" # gitleaks:allow
# Charm's apt signing key, for glow. Same "public key, deliberately in the
# clear" reasoning as eza's above.
# Heads-up: this key carries an expiry of 2027-07-13, which eza's does not. When
# it lapses upstream will publish a new one and the check below will fail loudly
# -- that is a rotation to verify by hand, not a bug to work around.
CHARM_KEY_FPR="ED927B38BE981E53CA09153D03BBF595D4DFD35C" # gitleaks:allow
RUSTUP_INIT_SHA256="6c30b75a75b28a96fd913a037c8581b580080b6ee9b8169a3c0feb1af7fe8caf"
LAZYGIT_VERSION="0.64.0"

# install eza: https://github.com/eza-community/eza#debian-and-ubuntu
# only set up the apt repo once; re-running is a no-op
if [ ! -f /etc/apt/sources.list.d/gierens.list ]; then
    sudo mkdir -p /etc/apt/keyrings
    # Verify the signing key's fingerprint before trusting it. Without this we
    # would import whatever raw.githubusercontent.com happened to return and
    # then trust an apt repo signed by it.
    # Bump: curl -fsSL <deb.asc url> | gpg --show-keys --with-colons | awk -F: '/^fpr:/{print $10}'
    keyfile=$(mktemp)
    wget -qO- https://raw.githubusercontent.com/eza-community/eza/main/deb.asc > "$keyfile"
    got_fpr=$(gpg --show-keys --with-colons "$keyfile" | awk -F: '/^fpr:/{print $10; exit}')
    if [ "$got_fpr" != "$EZA_KEY_FPR" ]; then
        echo "eza signing key fingerprint mismatch!" >&2
        echo "  expected: $EZA_KEY_FPR" >&2
        echo "  got:      $got_fpr" >&2
        rm -f "$keyfile"
        exit 1
    fi
    # Dearmor as the normal user and pipe into `tee` for the privileged write,
    # rather than `sudo gpg ... < "$keyfile"` -- sudo does not apply to the
    # shell's redirect, so that form mixes privilege levels confusingly
    # (shellcheck SC2024).
    gpg --dearmor < "$keyfile" | sudo tee /etc/apt/keyrings/gierens.gpg > /dev/null
    rm -f "$keyfile"
    echo "deb [signed-by=/etc/apt/keyrings/gierens.gpg] http://deb.gierens.de stable main" | sudo tee /etc/apt/sources.list.d/gierens.list
    sudo chmod 644 /etc/apt/keyrings/gierens.gpg /etc/apt/sources.list.d/gierens.list
    sudo apt update
fi
sudo apt install -y eza

# install glow: https://github.com/charmbracelet/glow#installation
# glow is in no Debian or Ubuntu repo, so upstream's own apt repo is the only
# apt route to it. Same shape as the eza block above, and hardened the same way:
# upstream's published recipe pipes the key straight into `gpg --dearmor`
# without ever looking at it, which trusts whatever repo.charm.sh returns.
#
# Two deliberate departures from that recipe:
#   - the fingerprint check below, as with eza;
#   - the sources file goes in /etc/apt/sources.list.d, not the /etc/sources.list.d
#     the README says. That is an upstream typo -- apt does not read the latter,
#     so following it verbatim registers nothing and `apt install glow` then
#     fails with "Unable to locate package".
# only set up the apt repo once; re-running is a no-op
if [ ! -f /etc/apt/sources.list.d/charm.list ]; then
    sudo mkdir -p /etc/apt/keyrings
    # Bump: curl -fsSL https://repo.charm.sh/apt/gpg.key | gpg --show-keys --with-colons | awk -F: '/^fpr:/{print $10}'
    keyfile=$(mktemp)
    wget -qO- https://repo.charm.sh/apt/gpg.key > "$keyfile"
    got_fpr=$(gpg --show-keys --with-colons "$keyfile" | awk -F: '/^fpr:/{print $10; exit}')
    if [ "$got_fpr" != "$CHARM_KEY_FPR" ]; then
        echo "charm signing key fingerprint mismatch!" >&2
        echo "  expected: $CHARM_KEY_FPR" >&2
        echo "  got:      $got_fpr" >&2
        rm -f "$keyfile"
        exit 1
    fi
    # Dearmor unprivileged and `tee` the privileged write, as with eza (SC2024).
    gpg --dearmor < "$keyfile" | sudo tee /etc/apt/keyrings/charm.gpg > /dev/null
    rm -f "$keyfile"
    # `* *` is not a placeholder -- repo.charm.sh is a flat repository, so the
    # suite and component fields are literal wildcards.
    echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" | sudo tee /etc/apt/sources.list.d/charm.list
    sudo chmod 644 /etc/apt/keyrings/charm.gpg /etc/apt/sources.list.d/charm.list
    sudo apt update
fi
sudo apt install -y glow

### RUST INSTALLS

# noninteractive rust install (needed for delta)
# Download-then-verify rather than curl | sh, so a tampered installer cannot
# execute before we have looked at it.
# Bump (Linux): curl -fsSL https://sh.rustup.rs | sha256sum
#       (macOS): curl -fsSL https://sh.rustup.rs | shasum -a 256
# NB: sha256sum, not shasum -- this script is Debian-only and sha256sum comes
# from coreutils (Essential), whereas shasum ships in the non-Essential `perl`
# package and can be missing on a minimal install.
rustup_init=$(mktemp)
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o "$rustup_init"
echo "${RUSTUP_INIT_SHA256}  ${rustup_init}" | sha256sum -c - || {
    echo "rustup-init.sh checksum mismatch -- refusing to run it." >&2
    echo "If upstream legitimately changed it, recompute and bump RUSTUP_INIT_SHA256." >&2
    rm -f "$rustup_init"
    exit 1
}
sh "$rustup_init" -y
rm -f "$rustup_init"
# shellcheck source=/dev/null
source "$HOME/.cargo/env"

# install delta
cargo install git-delta

# install lazygit
# Pinned: "latest" meant a silent, unreviewed binary swap on every fresh install.
# Bump: gh api repos/jesseduffield/lazygit/releases/latest --jq .tag_name
if [[ $(arch) == "x86_64" ]]; then
  LAZYGIT_ARCH="x86_64"
else
  LAZYGIT_ARCH="arm64"
fi
# Lowercase "linux" -- that is the real asset name. GitHub's download endpoint
# resolves the URL case-insensitively, which is why the old capital-L URL
# appeared to work, but `grep` against checksums.txt does not: a capital L
# matches nothing there and aborts the script under `set -o pipefail`.
LAZYGIT_TARBALL="lazygit_${LAZYGIT_VERSION}_linux_${LAZYGIT_ARCH}.tar.gz"
LAZYGIT_BASE="https://github.com/jesseduffield/lazygit/releases/download/v${LAZYGIT_VERSION}"
curl -fLo lazygit.tar.gz "${LAZYGIT_BASE}/${LAZYGIT_TARBALL}"
# Upstream publishes checksums.txt per release; verify against it.
curl -fLo lazygit-checksums.txt "${LAZYGIT_BASE}/checksums.txt"
grep " ${LAZYGIT_TARBALL}\$" lazygit-checksums.txt | sed "s|${LAZYGIT_TARBALL}|lazygit.tar.gz|" | sha256sum -c -
tar xf lazygit.tar.gz lazygit
sudo install lazygit /usr/local/bin
rm -f lazygit.tar.gz lazygit-checksums.txt lazygit

# navi
cargo install --locked navi

cargo install --locked cargo-binstall
cargo binstall --no-confirm tree-sitter-cli

# Remove packages
rm_packages=("nano")

for pkg in "${rm_packages[@]}"; do
    # Check if package is installed
    if command -v "$pkg" >/dev/null 2>&1; then
        echo "$pkg is installed. Removing it now."
        sudo apt remove -y "$pkg"
    fi
done

{{- end -}}
