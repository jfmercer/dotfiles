# ~/.zshenv — sourced by EVERY zsh: interactive, non-interactive, login,
# scripts, `ssh host 'cmd'`, cron, launchd, git hooks.
#
# Two hard rules for this file:
#   1. It must stay cheap. It runs before every `#!/usr/bin/env zsh` script.
#   2. It must NEVER print anything. Output here corrupts the scp/sftp/rsync
#      protocols, which is a memorably confusing failure to debug.
#
# Only order-independent environment belongs here. Everything interactive
# (aliases, plugins, prompt, completions) stays in .zshrc.

export DOTFILES="$HOME/.local/share/chezmoi"

# XDG base directories. Exported (not just defaulted at each use site) so that
# non-interactive tools and the apply-time scripts agree on the same paths.
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

# nvim for quick terminal edits and git commit messages; Zed is the GUI editor
# (see the `c`/`erc` aliases in system/alii.zsh). vim is still installed and
# still has its own config, but nothing points at it by default any more.
export VISUAL="nvim"
export EDITOR="$VISUAL"

# PAGER stays a bare command, with flags in LESS, because not every caller
# word-splits $PAGER before exec'ing it -- `PAGER="less -R"` becomes a search
# for a binary named "less -R" in those. LESS is read by less itself, so -R
# (pass ANSI color through raw) now applies to every invocation: man and any
# other tool that execs less directly. It replaces an
# `alias less="less -R"`, which only ever covered less typed at a prompt.
export PAGER="less"
export LESS="-R"

# `hunk pager` (core.pager in dot_gitconfig.tmpl) sniffs its input and only
# renders its TUI for a diff. Non-diff output -- `git branch`, `git log`
# without -p -- takes its pass-through path, which spawns `HUNK_TEXT_PAGER ??
# PAGER` and inherits the environment unchanged. It sets no LESS of its own, so
# a bare `less` there is governed entirely by the -R above: no -F, and two
# lines of branches sit in a full-screen pager waiting for `q`. delta never did
# this because it injects --quit-if-one-screen and --no-init into less's argv
# itself, the same trick bat uses (see system/exports.zsh).
#
# So the flags have to be in argv, where they beat $LESS -- which is why this
# is the one PAGER-ish variable here carrying its own flags, against the rule
# stated above. Safe because hunk word-splits the string rather than exec'ing
# it as one word. -F is quit-if-one-screen, -X is delta's --no-init (leave
# short output on screen instead of clearing it).
#
# HUNK_TEXT_PAGER is undocumented -- not in hunk's README #config section nor
# anywhere in its docs/ -- and was found by reading the 0.20.1 binary. It is
# also the ONLY route: the pass-through reads process.env directly, and hunk's
# config.toml has no key that reaches it (and silently ignores unknown keys, so
# an invented `text_pager =` there would look right and do nothing). Recheck on
# a major hunk bump; hunk's own default is `less -R`, missing -F the same way,
# so this stops being needed only if upstream fixes that.
export HUNK_TEXT_PAGER="less -FRX"

# PATH is deliberately NOT set here. On macOS /etc/zprofile runs path_helper
# AFTER this file and rebuilds PATH, demoting anything prepended here --
# measured: asdf shims move from position 1 to position 13, behind
# /usr/local/bin. PATH construction therefore stays in the */path.zsh topic
# files, which .zshrc sources after path_helper has already run.
#
# Consequence, accepted knowingly: non-interactive shells (`ssh host 'cmd'`,
# cron) do NOT get asdf shims, ~/.local/bin, or $DOTFILES/bin. Use an absolute
# path, or `ssh host -t 'zsh -ic "..."'`, when you need them there.
